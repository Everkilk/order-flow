NODE_ENV = development
PORT = 3000
HOST = 127.0.0.1
DATABASE_URL = postgresql://username:password@localhost:5432/orderflow
# Optional in local development. If set, use the exact browser origin,
# such as http://localhost:5173 for the Vite frontend.
# APP_ORIGIN = http://localhost:5173
DATA_DIR = data
STORAGE_DRIVER = filesystem
# Demo-only: process CSV jobs inside the API when no separate worker is deployed.
# EMBEDDED_WORKER = true
